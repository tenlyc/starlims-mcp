{
  "name": "@tenlyc/starlims-mcp",
  "version": "0.6.0",
  "description": "Standalone and embeddable MCP server for STARLIMS development tools",
  "type": "module",
  "main": "cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./cjs/index.js"
    },
    "./cli": "./dist/cli.js",
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./cjs/browser.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./cjs/client.js"
    }
  },
  "bin": {
    "starlims-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "scm/distribution",
    "scm/server",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "build:devtools-server": "node scripts/build-devtools-server.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js && npm run vendor:verify && node scripts/generate-tool-reference.mjs --check",
    "vendor:verify": "node scripts/verify-vendor.mjs",
    "vendor:refresh": "node scripts/refresh-vendor-manifests.mjs",
    "vendor:index": "node scripts/rebuild-vendor-index.mjs",
    "check": "npm run test",
    "build:scm-api": "node scripts/build-scm-api-package.mjs",
    "docs:tools": "node scripts/generate-tool-reference.mjs"
  },
  "repository": "https://github.com/tenlyc/starlims-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/hashes": "2.0.1",
    "@xmldom/xmldom": "^0.9.12",
    "express": "^5.2.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
