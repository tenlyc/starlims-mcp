{
  "name": "@tenlyc/starlims-mcp",
  "version": "0.5.0",
  "description": "Standalone and embeddable MCP server for STARLIMS development tools",
  "type": "module",
  "main": "cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./cjs/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "bin": {
    "starlims-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "cjs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "build:devtools-server": "node scripts/build-devtools-server.mjs",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js && npm run vendor:verify",
    "vendor:verify": "node scripts/verify-vendor.mjs",
    "vendor:index": "node scripts/rebuild-vendor-index.mjs",
    "check": "npm run test"
  },
  "repository": "https://github.com/tenlyc/starlims-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
