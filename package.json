{
  "name": "@tenlyc/starlims-mcp",
  "version": "0.1.2",
  "description": "Shared STARLIMS MCP contracts and host-neutral server runtime",
  "type": "module",
  "main": "cjs/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./cjs/index.js"
    }
  },
  "files": [
    "dist",
    "cjs",
    "scm",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run test"
  },
  "repository": "https://github.com/tenlyc/starlims-mcp",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
