{
  "schemaVersion": 2,
  "deployment": {
    "component": "SCM_API",
    "namespace": "SCM_API.*",
    "artifact": "SCM_API.sdp",
    "strategy": "merge-pinned-upstream-and-owned-extensions"
  },
  "sources": [
    {
      "owner": "MrDoe/starlimsvscode",
      "origin": "starlimsvscode",
      "prefix": "regular upstream names",
      "relationship": "derived-from-upstream"
    },
    {
      "owner": "tenlyc/starlims-mcp",
      "origin": "starlims-mcp",
      "prefix": "Mcp",
      "relationship": "original",
      "scripts": [
        "McpGetSCMUsers",
        "McpGetCheckInHistory",
        "McpExportPackage",
        "McpImportPackage"
      ]
    }
  ]
}
