/* starlims-mcp owned database executor. SQL Server only. Uses
 the existing STARLIMS Database connection. SQL is validated here,
 no connection strings or passwords are read or returned.
 HTTP deployment ACLs must restrict these endpoints to authorized developers. */;
:RETURN "Use the dedicated HTTP endpoints.";

:PROCEDURE Run;
:PARAMETERS payload, operation;
:DECLARE rx, dbnull, timer, dataSet, dataTable, rowIndex, timeoutBefore, transactionStarted;
:DECLARE whereParams, whereCount, started, stage;
:DECLARE sql, boundSql, params, limit, timeout, i, j, p, ch;
:DECLARE columns, rows, row, value, clipped, textCount, fieldCount, affected, expected;
:DECLARE identifier, tablePattern, wherePattern, insertPattern, updatePattern, deletePattern;
:DECLARE valid, match, tableName, whereSql, countCommand, result;
stage := "initialization";
transactionStarted := .F.;
timeoutBefore := NIL;
:TRY;
 stage := "regex";
 rx := LimsNetConnect("System", "System.Text.RegularExpressions.Regex", {}, .T.);
 stage := "DBNull";
 dbnull := LimsNetConnect(NIL, "System.DBNull", {}, .T.);
 :IF Empty(payload) .OR. !payload:IsProperty("sql") .OR. !payload:IsProperty("parameters") .OR. !payload:IsProperty("connection") .OR. !payload:IsProperty("timeoutSeconds");
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Missing database arguments."}});
 :ENDIF;
 sql := AllTrim(payload:sql);
 params := payload:parameters;
 timeout := payload:timeoutSeconds;
 :IF payload:connection != "Database" .OR. LimsTypeEx(params) != "ARRAY" .OR. Len(sql)<1 .OR. Len(sql)>20000 .OR. Len(params)>100;
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Invalid database arguments."}});
 :ENDIF;
 :IF LimsTypeEx(timeout) != "NUMERIC";
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Invalid timeout."}});
 :ENDIF;
 :IF timeout<1 .OR. timeout>30 .OR. timeout!=Round(timeout,0);
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Invalid timeout."}});
 :ENDIF;
 :FOR i := 1 :TO Len(params);
  :IF !Empty(params[i]) .AND. AScanExact({"STRING","NUMERIC","LOGICAL"},LimsTypeEx(params[i]))<=0;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Parameters must be scalar values."}});
  :ENDIF;
  :IF Len(LimsString(params[i]))>8000;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Parameter too long."}});
  :ENDIF;
 :NEXT;
 :IF operation == "query";
  :IF !payload:IsProperty("maxRows");
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Missing maxRows."}});
  :ENDIF;
  limit := payload:maxRows;
  :IF !rx:IsMatch(sql,"(?i)^SELECT\b") .OR. rx:IsMatch(sql,"[^A-Za-z0-9_\s?,.()=<>!+*/%\-]|--|/\*|\*/");
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Only a restricted SELECT with parameterized values is supported."}});
  :ENDIF;
  :IF rx:IsMatch(sql,"(?i)\b(INSERT|UPDATE|DELETE|MERGE|INTO|EXEC|EXECUTE|CREATE|ALTER|DROP|TRUNCATE|GRANT|DENY|REVOKE|USE|SET|DECLARE|WAITFOR|DBCC|BACKUP|RESTORE|BULK|OPENROWSET|OPENQUERY|OPENDATASOURCE|NEXT|OUTPUT|OPTION|FOR|WITH)\b") .OR. rx:IsMatch(sql,"\b[A-Za-z_][A-Za-z0-9_]*\s*\.\s*[A-Za-z_][A-Za-z0-9_]*\s*\.");
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Forbidden SQL clause or cross-database name."}});
  :ENDIF;
  :IF rx:IsMatch(sql,"(?i)\b(?!(?:COUNT|SUM|AVG|MIN|MAX|ABS|ROUND|CEILING|FLOOR|COALESCE|ISNULL|NULLIF|CAST|CONVERT|LEN|DATALENGTH|UPPER|LOWER|LTRIM|RTRIM|SUBSTRING|REPLACE|CONCAT|LEFT|RIGHT|YEAR|MONTH|DAY|DATEADD|DATEDIFF|GETDATE|GETUTCDATE|VARCHAR|NVARCHAR|CHAR|NCHAR|DECIMAL|NUMERIC|IN|EXISTS|NOT|AND|OR|AS|SELECT|TOP|VALUES)\s*\()[A-Z_][A-Z0-9_]*\s*\(") .OR. rx:IsMatch(sql,"\.\s*[A-Za-z_][A-Za-z0-9_]*\s*\(");
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Unsupported SQL function."}});
  :ENDIF;

 :ELSE;
  :IF operation != "change" .OR. !payload:IsProperty("maxAffectedRows") .OR. !payload:IsProperty("reason");
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Invalid change request."}});
  :ENDIF;
  :IF Empty(AllTrim(payload:reason)) .OR. Len(payload:reason)>500;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "A change reason is required."}});
  :ENDIF;
  limit := payload:maxAffectedRows;
  identifier := "[A-Za-z_][A-Za-z0-9_]*";
  tablePattern := identifier+"(?:\."+identifier+")?";
  wherePattern := identifier+"\s*(?:=|<>|!=|<=|>=|<|>)\s*\?(?:\s+AND\s+"+identifier+"\s*(?:=|<>|!=|<=|>=|<|>)\s*\?)*";
  insertPattern := "(?i)^INSERT\s+INTO\s+("+tablePattern+")\s*\(\s*"+identifier+"(?:\s*,\s*"+identifier+")*\s*\)\s+VALUES\s*\(\s*\?(?:\s*,\s*\?)*\s*\)$";
  updatePattern := "(?i)^UPDATE\s+("+tablePattern+")\s+SET\s+"+identifier+"\s*=\s*\?(?:\s*,\s*"+identifier+"\s*=\s*\?)*\s+WHERE\s+"+wherePattern+"$";
  deletePattern := "(?i)^DELETE\s+FROM\s+("+tablePattern+")\s+WHERE\s+"+wherePattern+"$";
  :IF !rx:IsMatch(sql,insertPattern) .AND. !rx:IsMatch(sql,updatePattern) .AND. !rx:IsMatch(sql,deletePattern);
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Only parameterized INSERT VALUES, UPDATE SET or DELETE with simple AND filters is supported."}});
  :ENDIF;

 :ENDIF;
 :IF LimsTypeEx(limit) != "NUMERIC";
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Invalid row limit."}});
 :ENDIF;
 :IF limit<1 .OR. limit>1000 .OR. limit!=Round(limit,0) .OR. (operation=="change" .AND. limit>100);
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Invalid row limit."}});
 :ENDIF;
 stage := "provider";
 :IF AScanExact({"SQLSERVER","NATIVESQL"},Upper(GetDBMSProviderName("Database")))<=0;
  :RETURN CreateUDObject({{"success", .F.}, {"message", "This endpoint currently supports SQL Server only. Provider="+GetDBMSProviderName("Database")}});
 :ENDIF;
 stage := "transaction-state";
 :IF IsInTransaction("Database");
  :RETURN CreateUDObject({{"success", .F.}, {"message", "Refusing to join an existing transaction."}});
 :ENDIF;
 boundSql := "";
 p := 0;
 :FOR i := 1 :TO Len(sql);
  ch := SubStr(sql,i,1);
  :IF ch=="?";
   boundSql += "?";
   p += 1;
  :ELSE;
   boundSql += ch;
  :ENDIF;
 :NEXT;
 :IF p!=Len(params);
  :RETURN CreateUDObject({{"success", .F.}, {"message", "SQL placeholder count does not match parameters."}});
 :ENDIF;
 stage := "timer";
 timer := LimsNetConnect("System", "System.Diagnostics.Stopwatch", {});
 timer:Start();
 stage := "timeout";
 timeoutBefore := SetSqlTimeout(timeout,"Database");
 :IF operation=="query";
 stage := "query";
  dataSet := GetNETDataSet("SELECT TOP ("+LimsString(limit+1)+") * FROM ("+sql+") AS MCP_RESULT", "Database", params, "MCP_RESULT", .F.);
 stage := "dataset";
  dataTable := dataSet:Tables[0];
  columns := {};
  rows := {};
  clipped := .F.;
  textCount := 0;
  fieldCount := dataTable:Columns:Count;
  :IF fieldCount>100;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Query exceeds 100 columns."}});
  :ENDIF;
  :FOR j := 0 :TO fieldCount-1;
 stage := "columns";
   AAdd(columns,CreateUDObject({{"name",dataTable:Columns[j]:ColumnName},{"type",dataTable:Columns[j]:DataType:Name}}));
  :NEXT;
  :FOR rowIndex := 0 :TO dataTable:Rows:Count-1;
   :IF Len(rows)>=limit .OR. textCount>=200000;
    clipped := .T.;
    :EXITFOR;
   :ENDIF;
   row := {};
   :FOR j := 0 :TO fieldCount-1;
 stage := "row-value";
    value := dataTable:Rows[rowIndex]:ItemArray[j+1];
    :IF dbnull:Value:Equals(value);
     value := NIL;
    :ELSE;
     :IF Len(LimsString(value))>8000;
      value := Left(LimsString(value),8000);
      clipped := .T.;
     :ENDIF;
     textCount += Len(LimsString(value));
    :ENDIF;
    AAdd(row,value);
   :NEXT;
   AAdd(rows,row);
  :NEXT;
  result := CreateUDObject({{"columns",columns},{"rows",rows},{"rowCount",Len(rows)},{"truncated",clipped},{"connection","Database"},{"readOnlyEnforcement","server-sql-validation"}});
 :ELSE;
  /* Serializable keeps matches stable between the count and the write. */;
  stage := "transaction";
  transactionStarted := BeginLimsTransaction("Database","Serializable");
  :IF !transactionStarted;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Could not start transaction."}});
  :ENDIF;
  expected := 1;
  :IF !rx:IsMatch(sql,insertPattern);
   match := rx:Match(sql,updatePattern);
   :IF !match:Success;
    match := rx:Match(sql,deletePattern);
   :ENDIF;
   tableName := match:Groups[1]:Value;
   boundSql := rx:Replace(sql,"\s+"," ");
   i := At(" WHERE ",Upper(boundSql));
   whereSql := SubStr(boundSql,i+7);
   whereCount := Len(whereSql)-Len(StrTran(whereSql,"?",""));
   whereParams := {};
   :FOR i := Len(params)-whereCount+1 :TO Len(params);
    AAdd(whereParams,params[i]);
   :NEXT;
   stage := "matching-count";
   expected := LSearch("SELECT COUNT_BIG(*) FROM "+tableName+" WHERE "+whereSql, -1, "Database", whereParams);
  :ENDIF;
  :IF expected<0 .OR. expected>limit;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Matching row count is unknown or exceeds the approved limit. Nothing was changed."}});
  :ENDIF;
  stage := "write";
  valid := RunSQL(sql,"Database",params);
  affected := LimsRecordsAffected();
  :IF !valid .OR. affected<0 .OR. affected>limit .OR. affected!=expected;
   :RETURN CreateUDObject({{"success", .F.}, {"message", "Write failed or affected row count exceeds the approved limit. Transaction rolled back."}});
  :ENDIF;
  stage := "commit";
  EndLimsTransaction("Database",.T.);
  transactionStarted := .F.;
  result := CreateUDObject({{"affectedRows",affected},{"matchedRows",expected},{"committed",.T.},{"connection","Database"}});
 :ENDIF;
 timer:Stop();
 result:elapsedMs := timer:ElapsedMilliseconds;
 :RETURN CreateUDObject({{"success",.T.},{"data",result}});
:CATCH;
 :RETURN CreateUDObject({{"success",.F.},{"message","Database operation failed at "+stage+". A lost response after commit has unknown outcome; inspect data before retrying."}});
:FINALLY;
 :TRY;
  :IF transactionStarted;
   EndLimsTransaction("Database",.F.);
  :ENDIF;
 :FINALLY;
  :IF timeoutBefore!=NIL;
   SetSqlTimeout(timeoutBefore,"Database");
  :ENDIF;
 :ENDTRY;
:ENDTRY;
:ENDPROC;
